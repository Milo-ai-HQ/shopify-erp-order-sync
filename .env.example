# Which ERP to write to: priority | netsuite | business-central | odoo
ERP=priority
SHOPIFY_WEBHOOK_SECRET=
DEFAULT_CUSTOMER=WEB
# B2B buyers: Shopify e-mail -> ERP customer code
CUSTOMER_BY_EMAIL={"buyer@acme.example":"C1001"}

PRIORITY_URL=https://erp.example.com/odata/Priority/tabula.ini/demo
PRIORITY_USER=
PRIORITY_PASSWORD=
# or a personal access token instead of user/password
PRIORITY_TOKEN=

NETSUITE_URL=https://1234567.suitetalk.api.netsuite.com
NETSUITE_TOKEN=

BC_URL=https://api.businesscentral.dynamics.com/v2.0/<tenant>/production
BC_COMPANY_ID=
BC_TOKEN=

ODOO_URL=https://mycompany.odoo.com
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
